{
  "name": "@wolvesdotink/strapi-plugin-translate",
  "version": "0.2.2",
  "description": "AI-powered translation of localized Strapi v5 entries via OpenRouter LLMs.",
  "keywords": [
    "strapi",
    "plugin",
    "strapi-plugin",
    "translate",
    "translation",
    "i18n",
    "localization",
    "openrouter",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "author": "wolves.ink",
  "homepage": "https://github.com/wolvesdotink/strapi-plugin-translate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolvesdotink/strapi-plugin-translate.git"
  },
  "bugs": {
    "url": "https://github.com/wolvesdotink/strapi-plugin-translate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "fixture": "node scripts/fixture-app.mjs",
    "test:integration": "npm run build && node scripts/integration-test.mjs && node scripts/selective-regression-test.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "openai": "^7.32.0"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/utils": "^5.57.0",
    "better-sqlite3": "^13.0.3",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/strapi": "^5.57.0",
    "@strapi/utils": "^5.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3"
  },
  "strapi": {
    "name": "translate",
    "kind": "plugin",
    "displayName": "Translate",
    "description": "AI-powered translation of localized entries via OpenRouter."
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
